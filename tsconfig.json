{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "paths": {
      "tailwindcss": ["./node_modules/tailwindcss/dist/lib.d.mts"]
    },
    "lib": ["DOM", "ES2021.String"]
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules", "playground"]
}
